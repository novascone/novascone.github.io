@comment{
  Add your publications here in BibTeX format. Each entry appears on the
  publications page, grouped by year. al-folio extras you can add to an entry:
    abbr={Venue}, selected={true}, pdf={file.pdf}, html={https://...},
    preview={image.png}, bibtex_show={true}, abstract={...}
  Example, to copy below this comment and edit (start it with an at-sign):

  article{novascone2026example,
    title={Title of the Paper},
    author={Novascone, Warren R. and Coauthor, A.},
    journal={Journal Name},
    year={2026},
    abbr={JRNL},
  }
}
