{% comment %} Repositories section: shared by the home page and /repositories/. Data: _data/repositories.yml {% endcomment %}
{% assign repos = site.data.repositories %}
{% if repos.github_users %}
  <h2>GitHub users</h2>
  <div class="repositories d-flex flex-wrap flex-md-row flex-column justify-content-between align-items-center">
    {% for user in repos.github_users %}
      {% include repository/repo_user.liquid username=user %}
    {% endfor %}
  </div>
  <hr>
  {% if site.repo_trophies.enabled %}
    {% for user in repos.github_users %}
      {% if repos.github_users.size > 1 %}
        <h4>{{ user }}</h4>
      {% endif %}
      <div class="repositories d-flex flex-wrap flex-md-row flex-column justify-content-between align-items-center">
        {% include repository/repo_trophies.liquid username=user %}
      </div>
      <hr>
    {% endfor %}
  {% endif %}
{% endif %}

{% if repos.github_orgs %}
  <h2>Organizations</h2>
  <ul class="github-orgs">
    {% for org in repos.github_orgs %}
      <li>
        <a href="https://github.com/{{ org.login }}">{{ org.name | default: org.login }}</a>
        <span class="mono">({{ org.login }})</span>
      </li>
    {% endfor %}
  </ul>
  <hr>
{% endif %}

{% if repos.github_repos %}
  <h2>GitHub Repositories</h2>
  <div class="repositories d-flex flex-wrap flex-md-row flex-column justify-content-between align-items-center">
    {% for repo in repos.github_repos %}
      {% include repository/repo.liquid repository=repo %}
    {% endfor %}
  </div>
{% endif %}
